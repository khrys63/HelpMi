# Credentials MariaDB
DB_USER=helpmi
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me

# Keycloak intégré (service "keycloak" du compose)
# Laisser ces variables vides si vous utilisez un KC tiers (voir APP_KEYCLOAK_* ci-dessous)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me

# Keycloak — URLs (backend + frontend)
# Défauts : KC intégré. Pour un KC tiers, remplacer et supprimer le service keycloak du compose.
APP_KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/helpmi
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=helpmi
VITE_KEYCLOAK_CLIENT_ID=helpmi-frontend

# CORS (URL publique du frontend en prod)
APP_CORS_ALLOWED_ORIGINS=https://helpmi.example.com

# Credentials MinIO (stockage des pièces jointes)
# En prod sur S3 externe : remplacer les 3 variables APP_S3_* côté backend plutôt que MINIO_ROOT_*
MINIO_ROOT_USER=helpmi
MINIO_ROOT_PASSWORD=change_me
